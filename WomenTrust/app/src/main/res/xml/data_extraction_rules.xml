<?xml version="1.0" encoding="utf-8"?><!--
   Cloud backup and device transfer rules. Exclude auth/session stores so a
   refresh token can never be restored onto a different device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auth_secure.xml" />
        <exclude domain="sharedpref" path="WomenTrust_Shared.xml" />
        <exclude domain="sharedpref" path="device_info.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth_secure.xml" />
        <exclude domain="sharedpref" path="WomenTrust_Shared.xml" />
        <exclude domain="sharedpref" path="device_info.xml" />
    </device-transfer>
</data-extraction-rules>
