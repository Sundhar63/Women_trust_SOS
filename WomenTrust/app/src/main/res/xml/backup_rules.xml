<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules. Session tokens and profile data must never be restored onto
   another device, so the auth stores are excluded from backup.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="auth_secure.xml" />
    <exclude domain="sharedpref" path="WomenTrust_Shared.xml" />
    <exclude domain="sharedpref" path="device_info.xml" />
</full-backup-content>
