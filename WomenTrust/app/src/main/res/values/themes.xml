<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.WomenTrust" parent="Theme.Material3.DayNight">
        <!-- Customize your light theme here. -->
         <item name="colorPrimary">@color/pink_color</item>
         <item name="colorSecondary">@color/black</item>
         <item name="colorPrimaryDark">@color/pink_dark</item>
         <item name="fontFamily">@fonts/font_family_medium</item>
         <item name="statusBarBackground">@color/colorPrimaryDark</item>
         <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="Theme.WomenTrust" parent="Base.Theme.WomenTrust" />

    <style name="Theme.WomenTrust.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/white</item>
    </style>
</resources>